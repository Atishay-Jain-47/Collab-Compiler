spring.application.name=CompilerProject
server.port=${PORT:8082}
BASE_DIR=${COMPILER_BASE_DIR:${java.io.tmpdir}/compiler/}
spring.mongodb.uri=${SPRING_MONGODB_URI:mongodb+srv://<username>:<password>@cluster0.nksf5u0.mongodb.net/compiler?appName=Cluster0}
spring.data.mongodb.uri=${SPRING_MONGODB_URI:${spring.mongodb.uri}}
spring.data.mongodb.auto-index-creation=true
JWT_SECRET_KEY=${JWT_SECRET_KEY:your_jwt_secret_key_here}
GEMINI_API_KEY=${GEMINI_API_KEY:your_gemini_api_key_here}

# Sandbox Execution Engine Configuration
# Options: auto (prefer Docker, fallback to process) | docker (strict Docker) | process (host OS)
compiler.sandbox.type=auto
compiler.sandbox.docker.image=collab-compiler-runner:latest
compiler.sandbox.docker.memory=256m
compiler.sandbox.docker.cpus=1.0
compiler.sandbox.docker.pids-limit=64
compiler.sandbox.docker.network=none
compiler.sandbox.timeout-seconds=15